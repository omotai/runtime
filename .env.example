# Copy to .env and fill in. Never commit .env.

# Docker Compose (required): token to sign in to the dashboard and call /api/*. 16+ characters.
OMOTAI_ADMIN_TOKEN=

# Optional: use another SQLite file (default runs/omotai.db)
# OMOTAI_DB=

# Only for running the evaluation harness (omotai/eval) or the tests that call a real model
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Local model via Ollama (optional)
OLLAMA_HOST=http://localhost:11434
